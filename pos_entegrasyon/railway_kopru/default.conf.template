# KasaCepte köprüsü — gelen her istek hosting'deki sync.php'ye aynen iletilir.
# Hosting'e AZ SAYIDA KALICI (keep-alive) TLS bağlantısı tutulur; istemci sayısı
# ne olursa olsun hosting tarafında yeni bağlantı fırtınası oluşmaz.

upstream kasacepte_hosting {
    # HEDEF_UPSTREAM = hosting'in IP'si (DNS köprüye çevrildiğinde alan adı köprünün kendisine
    # çözüleceği için döngüyü önlemek üzere IP kullanılır). Host/SNI yine ${HEDEF_HOST}.
    server ${HEDEF_UPSTREAM}:443;
    keepalive 16;
    keepalive_timeout 120s;
    keepalive_requests 10000;
}

server {
    listen ${PORT};
    server_name _;

    # Büyük veri sayfaları (stok listesi parçaları ~450 KB, rapor sonuçları)
    client_max_body_size 64m;
    client_body_timeout 120s;

    # Sağlık kontrolü (Railway healthcheck için)
    location = /kopru-saglik {
        default_type application/json;
        return 200 '{"ok":true,"kopru":"nginx","hedef":"${HEDEF_HOST}","upstream":"${HEDEF_UPSTREAM}"}';
    }

    location / {
        proxy_pass https://kasacepte_hosting;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${HEDEF_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Kopru "railway";

        proxy_ssl_server_name on;
        proxy_ssl_name ${HEDEF_HOST};
        proxy_ssl_protocols TLSv1.2 TLSv1.3;
        proxy_ssl_session_reuse on;

        # Uzun raporlar / büyük yüklemeler (client.py zaman aşımı 300 sn)
        proxy_connect_timeout 20s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_request_buffering on;
        proxy_buffering off;

        # Hosting kısa bir an düşerse bir sonraki bağlantıyla tekrar dene
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
    }
}
